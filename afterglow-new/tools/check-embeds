#!/usr/bin/env python3
"""Afterglow embed-health check.

Checks every catalog title still plays as an embed from its official source:
  - YouTube: oEmbed (401/403 = embedding off, 404 = removed/private) and the
    embed page's playabilityStatus (UNPLAYABLE / ERROR / LOGIN_REQUIRED = age-gated).
  - Internet Archive: item metadata still exists and isn't dark.
  - Plain MP4 (an official file on the Archive): HTTP HEAD.

Usage:
  tools/check-embeds            report only
  tools/check-embeds --apply    also remove unplayable titles from new-recent.json,
                                regenerate catalog.js, and drop them from now-showing.json

Note: this runs from wherever you run it. Region locks (e.g. in Dominica) only
show up when checked from that country; the in-page player handles those live.
Nothing is downloaded or re-hosted; only status is read.
"""
import json, os, re, sys, urllib.request, urllib.error, urllib.parse

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
UA = {"User-Agent": "Mozilla/5.0 (Afterglow embed-health check)"}

def get(url, method="GET"):
    req = urllib.request.Request(url, headers=UA, method=method)
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.status, (r.read(4000000).decode("utf-8", "replace") if method == "GET" else "")
    except urllib.error.HTTPError as e:
        return e.code, ""
    except Exception as e:
        return 0, str(e)

def check_youtube(vid):
    s, _ = get("https://www.youtube.com/oembed?format=json&url=" + urllib.parse.quote("https://www.youtube.com/watch?v=" + vid))
    if s in (401, 403): return False, "embedding disabled"
    if s in (400, 404): return False, "removed or private"
    if s != 200: return None, "oEmbed HTTP %s (network?)" % s
    s, html = get("https://www.youtube.com/embed/" + vid)
    m = re.search(r'\\?"playabilityStatus\\?":\{\\?"status\\?":\\?"(\w+)', html)
    if m and m.group(1) in ("UNPLAYABLE", "ERROR", "LOGIN_REQUIRED"):
        return False, "embed page says " + m.group(1)
    return True, "ok"

def check_archive(ident):
    s, body = get("https://archive.org/metadata/" + ident)
    if s != 200: return None, "metadata HTTP %s" % s
    try: j = json.loads(body)
    except Exception: return None, "metadata unreadable"
    if not j or j.get("is_dark") or "metadata" not in j: return False, "item gone or dark"
    return True, "ok"

def check_mp4(url):
    s, _ = get(url, "HEAD")
    if s in (200, 302, 301): return True, "ok"
    if s in (403, 404, 410): return False, "file HTTP %s" % s
    return None, "HTTP %s" % s

def check(it):
    p = it.get("play", {})
    t = p.get("type")
    if t == "youtube": return check_youtube(p["id"])
    if t == "archive": return check_archive(p["id"])
    if t == "mp4": return check_mp4(p["src"])
    return None, "unknown player type"

def main():
    apply = "--apply" in sys.argv
    path = os.path.join(ROOT, "new-recent.json")
    data = json.load(open(path))
    bad, unsure = [], []
    for it in data["items"]:
        ok, why = check(it)
        mark = {True: "OK  ", False: "DEAD", None: "??  "}[ok]
        print("%s %-40s %s" % (mark, it["id"], why))
        if ok is False: bad.append(it["id"])
        elif ok is None: unsure.append(it["id"])
    print("\n%d checked, %d unplayable, %d unsure (kept)" % (len(data["items"]), len(bad), len(unsure)))
    if apply and bad:
        data["items"] = [x for x in data["items"] if x["id"] not in bad]
        shelves = {}
        for x in data["items"]: shelves[x.get("shelf", "recent")] = shelves.get(x.get("shelf", "recent"), 0) + 1
        data["count"], data["shelves"] = len(data["items"]), shelves
        removed = data.setdefault("removedByHealthCheck", [])
        removed.extend(bad)
        json.dump(data, open(path, "w"), indent=2, ensure_ascii=False)
        ns = os.path.join(ROOT, "now-showing.json")
        if os.path.exists(ns):
            n = json.load(open(ns))
            n["windows"] = [w for w in n["windows"] if w["id"] not in bad]
            json.dump(n, open(ns, "w"), indent=1, ensure_ascii=False)
        print("Removed:", ", ".join(bad))
    if apply:
        open(os.path.join(ROOT, "catalog.js"), "w").write("window.AFTERGLOW_NEW=" + json.dumps(data, ensure_ascii=False) + ";\n")
        print("catalog.js regenerated")
    return 1 if bad and not apply else 0

if __name__ == "__main__":
    sys.exit(main())
