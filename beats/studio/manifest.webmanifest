{
  "id": "/beats/studio",
  "name": "Beats Studio",
  "short_name": "Studio",
  "description": "Multitrack studio",
  "start_url": "/beats/studio/",
  "scope": "/beats/studio/",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#120e18",
