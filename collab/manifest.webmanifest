{
  "id": "/collab/",
  "name": "Collab Map",
  "short_name": "Collab",
  "description": "Find collaborators on a Dominica map",
  "start_url": "/collab/",
  "scope": "/collab/",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#081612",
